# ===== Godot 4 本地缓存与导入产物 =====
# .godot/ 是引擎自动生成的缓存（class_name 索引 / uid 缓存 / 导入纹理 / 与显卡驱动
# 绑定的 shader 二进制缓存，本机约 3.3 MB）。它不该进版本库：
# 换机器或换 Godot 版本后本来就会失效，克隆后首次打开编辑器会自动重建。
.godot/

# ===== Godot 导出 / 构建产物 =====
/build/
/export/
*.translation

# ===== 音效试听用的导出 WAV（tools/sfx_tool.gd -- --wav 生成，随时可重建）=====
/audio_preview/

# ===== XSXB-Band 作曲工具（外部仓库，见 README「背景音乐」一节）=====
# 工具本体在 F:\aigc_code\XSXB-Band，自带 579 MB CC0 采样库与导出渲染。
# 万一有人在工程里再克隆一份、或把导出目录指向工程内，别让 git add -A 把几百 MB 采样卷进来：
# 本工程只收 audio/bgm/ 下两首成品 Ogg。
/XSXB-Band/
# 渲染管线的中间 WAV（裁头 / 补尾 / 混音），成品只留 Ogg
/audio/bgm/*.wav

# ===== macOS =====
.DS_Store
._*

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp
*~
